    "destructive-bg":       { "$value": "oklch(95% 0.03 25)",       "$type": "color" },
    "destructive-fg":       { "$value": "oklch(40% 0.2 27)",        "$type": "color", "$description": "Tint badge text · 5.0:1 AA on destructive-bg" },
    "solid-badge-fg":       { "$value": "oklch(99% 0 0)",           "$type": "color", "$description": "Near-white on solid badge fill" },
    "secondary":            { "$value": "oklch(96% 0.02 285)",      "$type": "color" },
    "secondary-foreground": { "$value": "oklch(15% 0.02 285)",      "$type": "color" },
    "muted":                { "$value": "oklch(96% 0.02 285)",      "$type": "color", "$description": "Skeleton base, disabled bg, table header" },
    "accent":               { "$value": "oklch(96% 0.02 285)",      "$type": "color", "$description": "Hover bg — nav, ghost button, table row" },
    "accent-foreground":    { "$value": "oklch(15% 0.02 285)",      "$type": "color" },
    "border":               { "$value": "oklch(90% 0.02 285)",      "$type": "color" },
    "input":                { "$value": "oklch(90% 0.02 285)",      "$type": "color" },
    "ring":                 { "$value": "oklch(54% 0.25 277)",      "$type": "color", "$description": "Focus ring = primary" },
    "sidebar":              { "$value": "oklch(98% 0.01 285)",      "$type": "color" },
    "sidebar-fg":           { "$value": "oklch(15% 0.02 285)",      "$type": "color" },
    "sidebar-border":       { "$value": "oklch(90% 0.02 285)",      "$type": "color" },
    "sidebar-accent":       { "$value": "oklch(96% 0.02 285)",      "$type": "color" },
    "chart-1":              { "$value": "oklch(54% 0.25 277)",      "$type": "color", "$description": "Indigo · primary series" },
    "chart-2":              { "$value": "oklch(65% 0.13 320)",      "$type": "color", "$description": "Magenta · secondary" },
    "chart-3":              { "$value": "oklch(40% 0.22 276)",      "$type": "color", "$description": "Deep indigo · tertiary" },
    "chart-4":              { "$value": "oklch(70% 0.16 165)",      "$type": "color", "$description": "Mint · positive" },
    "chart-5":              { "$value": "oklch(65% 0.18 310)",      "$type": "color", "$description": "Purple · fifth only" },
    "channel-zalo":         { "$value": "oklch(50% 0.16 250)", "$type": "color", "$description": "Zalo OA · đủ AA làm chữ trên nền tonal 12%" },
    "channel-facebook":     { "$value": "oklch(51% 0.16 285)", "$type": "color", "$description": "Facebook · đủ AA làm chữ trên nền tonal 12%" },
    "channel-pancake":      { "$value": "oklch(50% 0.14 55)", "$type": "color", "$description": "Pancake/Shopee · đủ AA làm chữ trên nền tonal 12%" }
  },
