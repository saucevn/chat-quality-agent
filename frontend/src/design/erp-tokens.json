    "card":                 { "$value": "oklch(16% 0.02 285)",      "$type": "color", "$description": "Lighter than page for elevation" },
    "popover":              { "$value": "oklch(16% 0.02 285)",      "$type": "color" },
    "foreground":           { "$value": "oklch(95% 0.02 285)",      "$type": "color" },
    "card-foreground":      { "$value": "oklch(95% 0.02 285)",      "$type": "color" },
    "popover-foreground":   { "$value": "oklch(95% 0.02 285)",      "$type": "color" },
    "muted-foreground":     { "$value": "oklch(72% 0.02 257)",      "$type": "color", "$description": "6.2:1 AA — 72% locked, never 65%" },
    "primary":              { "$value": "oklch(70% 0.22 277)",      "$type": "color", "$description": "Brighter indigo for dark bg" },
    "primary-foreground":   { "$value": "oklch(20% 0.02 285)",      "$type": "color", "$description": "Dark text on bright primary · 5.6:1 AA" },
