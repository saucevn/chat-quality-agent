    "amber-border":         { "$value": "oklch(92.4% 0.12 95.746)", "$type": "color", "$description": "Warning banner border" },
    "amber-fg":             { "$value": "oklch(40% 0.11 58.318)",   "$type": "color", "$description": "Tint badge text — cặp lật theo theme của success-fg/destructive-fg. KHÁC amber-foreground (chữ trên nền amber ĐẶC, tối ở cả hai theme): amber-fg dùng cho chữ amber trên nền SÁNG/tint · 8.3:1 AA trên chip tonal" },
    "success":              { "$value": "oklch(50.8% 0.118 165.612)","$type": "color", "$description": "Online dot, success icon, chart positive" },
    "success-bg":           { "$value": "oklch(95% 0.052 163.051)", "$type": "color", "$description": "Tint badge bg" },
    "success-fg":           { "$value": "oklch(32% 0.11 165)",      "$type": "color", "$description": "Tint badge text · 5.6:1 AA on success-bg" },
    "destructive":          { "$value": "oklch(57.7% 0.245 27.325)","$type": "color", "$description": "Error, destructive fill, solid critical badge" },
