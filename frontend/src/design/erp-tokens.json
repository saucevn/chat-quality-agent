    "success-fg":           { "$value": "oklch(88% 0.13 165)",      "$type": "color", "$description": "5.4:1 AA in dark" },
    "destructive":          { "$value": "oklch(70.4% 0.191 22.216)","$type": "color" },
    "destructive-foreground":{ "$value": "oklch(15% 0.02 285)",     "$type": "color" },
    "destructive-bg":       { "$value": "oklch(30% 0.1 25)",        "$type": "color" },
    "destructive-fg":       { "$value": "oklch(88% 0.16 27)",       "$type": "color", "$description": "5.6:1 AA in dark" },
    "solid-badge-fg":       { "$value": "oklch(99% 0 0)",           "$type": "color" },
    "secondary":            { "$value": "oklch(22% 0.02 285)",      "$type": "color" },
    "secondary-foreground": { "$value": "oklch(95% 0.02 285)",      "$type": "color" },
    "muted":                { "$value": "oklch(22% 0.02 285)",      "$type": "color" },
    "accent":               { "$value": "oklch(22% 0.02 285)",      "$type": "color" },
    "accent-foreground":    { "$value": "oklch(95% 0.02 285)",      "$type": "color" },
    "border":               { "$value": "oklch(25% 0.02 285)",      "$type": "color" },
    "input":                { "$value": "oklch(25% 0.02 285)",      "$type": "color" },
    "ring":                 { "$value": "oklch(70% 0.22 277)",      "$type": "color" },
    "sidebar":              { "$value": "oklch(14% 0.02 285)",      "$type": "color" },
    "sidebar-fg":           { "$value": "oklch(95% 0.02 285)",      "$type": "color" },
    "sidebar-border":       { "$value": "oklch(25% 0.02 285)",      "$type": "color" },
    "sidebar-accent":       { "$value": "oklch(22% 0.02 285)",      "$type": "color" },
    "chart-1":              { "$value": "oklch(70% 0.22 277)",      "$type": "color" },
    "chart-2":              { "$value": "oklch(72% 0.13 320)",      "$type": "color" },
    "chart-3":              { "$value": "oklch(60% 0.22 276)",      "$type": "color" },
    "chart-4":              { "$value": "oklch(74% 0.16 165)",      "$type": "color" },
    "chart-5":              { "$value": "oklch(72% 0.18 310)",      "$type": "color" },
    "channel-zalo":         { "$value": "oklch(64% 0.16 250)", "$type": "color" },
    "channel-facebook":     { "$value": "oklch(65% 0.16 285)", "$type": "color" },
    "channel-pancake":      { "$value": "oklch(65% 0.14 55)", "$type": "color" }
  },
  "component": {
    "agent": {
      "ring-color-light":  { "$value": "oklch(54% 0.25 277)",       "$type": "color", "$description": "Indigo ring around automation-agent avatar" },
      "ring-color-dark":   { "$value": "oklch(70% 0.22 277)",       "$type": "color" },
      "ring-width":        { "$value": "2px",                       "$type": "borderWidth" },
      "dot-running-light": { "$value": "oklch(66.6% 0.179 58.318)", "$type": "color", "$description": "Amber pulse when agent is running" },
