# =============================================================================
# Chat Quality Agent - Biến môi trường
# =============================================================================
# Sao chép file này thành .env và điền thông tin phù hợp:
#   cp .env.example .env

# --- Server ---
# Khi chạy bằng docker compose, SERVER_PORT/SERVER_HOST/APP_ENV được đặt cứng
# trong docker-compose.yml và KHÔNG đọc từ đây. Ba dòng dưới chỉ dùng khi bạn
# chạy binary trực tiếp ngoài Docker.
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
APP_ENV=production
# APP_URL=https://cqa.example.com  # URL công khai (dùng cho links trong notification)

# --- Cổng trên máy chủ (chỉ cần khi cổng mặc định đã bị dịch vụ khác chiếm) ---
# HTTP_PORT=80          # cổng host cho nginx HTTP
# HTTPS_PORT=443        # cổng host cho nginx HTTPS
# DB_PORT_HOST=3306     # cổng host cho MySQL, luôn chỉ bind vào 127.0.0.1

# --- Database (MySQL 8+) ---
DB_HOST=db
DB_PORT=3306
DB_USER=cqa
DB_PASSWORD=       # Bắt buộc — mật khẩu MySQL cho user cqa
DB_NAME=cqa
MYSQL_ROOT_PASSWORD=  # Bắt buộc — mật khẩu root MySQL

# --- Bảo mật (BẮT BUỘC — tạo giá trị ngẫu nhiên cho production) ---
# JWT_SECRET: chuỗi ngẫu nhiên, tối thiểu 32 ký tự
#   Tạo: openssl rand -hex 32
JWT_SECRET=

# ENCRYPTION_KEY: đúng 32 ký tự, dùng làm khoá AES-256-GCM
#   Tạo: openssl rand -base64 24    (32 ký tự, 192 bit entropy)
#   `openssl rand -hex 16` cũng ra 32 ký tự nhưng chỉ 128 bit.
#   SAO LƯU KHOÁ NÀY RA NGOÀI MÁY CHỦ — mất là không giải mã lại được
#   credential của các kênh, kể cả khi còn bản sao lưu database.
ENCRYPTION_KEY=

# --- Rate Limiting (mỗi phút) ---
RATE_LIMIT_PER_IP=500
RATE_LIMIT_PER_USER=1000

# --- SSL (tùy chọn — để trống nếu dùng HTTP) ---
# Đặt domain để tự động tạo và gia hạn SSL qua Let's Encrypt
# LEGO_DOMAIN=cqa.example.com
# LEGO_EMAIL=admin@example.com
