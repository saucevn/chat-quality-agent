# =============================================================================
# Chat Quality Agent - Biến môi trường cho DEV LOCAL
# =============================================================================
# File này ĐƯỢC COMMIT vào git. Toàn bộ giá trị bên dưới chỉ dùng cho máy dev:
# MySQL chỉ bind vào 127.0.0.1, không có dữ liệu thật, không dùng cho production.
#
# KHÔNG dùng file này để deploy. Production dùng .env (xem .env.example).
#
# Lưu ý cú pháp: file này được Makefile `include`, nên KHÔNG viết comment
# nằm cùng dòng với giá trị (vd `KEY=value # ghi chu`) - sẽ lọt vào giá trị.

# --- Server ---
# development => backend KHÔNG serve SPA từ ./static và CORS mở cho Vite :3000
APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# --- Database (MySQL 8.0 chạy trong Docker qua docker-compose.dev.yml) ---
# 127.0.0.1 chứ không phải `db`: backend chạy native trên host, không trong Docker
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cqa
DB_PASSWORD=cqa_dev_password
DB_NAME=cqa_dev
MYSQL_ROOT_PASSWORD=cqa_dev_root_password

# --- Bảo mật ---
# JWT_SECRET: backend yêu cầu tối thiểu 32 ký tự (config/config.go:56)
JWT_SECRET=cqa_dev_jwt_secret_not_for_production_0123456789
# ENCRYPTION_KEY: backend yêu cầu ĐÚNG 32 ký tự cho AES-256-GCM (config/config.go:62)
ENCRYPTION_KEY=cqa_dev_encryption_key_32bytes__

# --- Rate limiting (nới rộng khi dev để không bị chặn lúc bấm nhiều) ---
RATE_LIMIT_PER_IP=10000
RATE_LIMIT_PER_USER=10000

# --- AI ---
AI_MAX_TOKENS=16384

# --- Tài khoản admin mà `make seed` sẽ tạo ---
DEV_ADMIN_EMAIL=dev@localhost.local
DEV_ADMIN_PASSWORD=DevPass123
DEV_TENANT_NAME="Dev Workspace"
DEV_TENANT_SLUG=dev-workspace
